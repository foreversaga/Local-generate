# Copy this file to .env.local and replace only the values needed on your machine.
# Never commit .env.local, credentials, tokens, or provider secrets.

# External local runtimes. MINIMAX_H3_ROOT is required by start-local-runtime.ps1.
MINIMAX_H3_ROOT=
COMFYUI_ROOT=
MINIMAX_H3_PYTHON=

# Optional project-local data and ownership settings.
MINIMAX_H3_LOGS_ROOT=
MINIMAX_H3_SINGLE_VIDEO_DATA_ROOT=
MINIMAX_H3_SINGLE_VIDEO_OWNER_ID=

# Local and tunneled service endpoints.
LOCAL_COMFY_URL=http://127.0.0.1:8188
LOCAL_OLLAMA_URL=http://127.0.0.1:11434
REMOTE_COMFY_URL=http://127.0.0.1:18188
REMOTE_OLLAMA_URL=http://127.0.0.1:11435
COMFY_URL=
OLLAMA_URL=
COMFY_REMOTE=0
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_KEEP_ALIVE=0
OLLAMA_CAPTION_MODEL=

# Docker vLLM OpenAI-compatible prompt provider. Legacy SGLANG_* names remain
# accepted by the bridge for existing local environments.
VLLM_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=
VLLM_PROMPT_MODEL=qwen3.5-9b-vision
NATURE_CAMERA_SKILL_PATH=

# Optional SDXL pose-control settings. The model name must match a file exposed
# by ComfyUI's ControlNetLoader (for example an installed SDXL OpenPose model).
H3_IMG2IMG_POSE_CONTROLNET=
H3_IMG2IMG_POSE_STRENGTH=1
H3_IMG2IMG_POSE_RESOLUTION=768

# Media tools. Leave blank when ffmpeg and ffprobe are already on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Optional Codex prompt-generation overrides.
CODEX_CLI_PATH=
CODEX_HOME=
H3_PROMPT_SKILL_PATH=

# Optional runtime behavior and Vast configuration location.
MINIMAX_H3_SINGLE_VIDEO_AUTO_RESUME=1
VAST_RUNTIME_CONFIG=
